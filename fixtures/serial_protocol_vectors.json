        {
          "t_ms": 0,
          "send": "{\"type\":\"disarm\",\"session\":\"pi01\",\"seq\":1}",
          "emit": [
            {
              "type": "state",
              "session": "pi01",
              "armed": false,
              "ack": 1,
              "fault": null
            }
          ],
          "armed": false,
          "outputs": {
            "fl": 0,
            "fr": 0,
            "rl": 0,
            "rr": 0
          }
        }
      ]
    },
