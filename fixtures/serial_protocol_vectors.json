{
  "description": "Proposed ESP32-S2 serial behavior vectors. Each case starts from a fresh boot with watchdog_ms and hardware_ceiling defaults unless overridden. Each step sends one line (a newline is appended) at t_ms, or advances the watchdog with tick; emit lists the JSON lines expected in response, in order.",
  "watchdog_ms": 500,
  "hardware_ceiling": 255,
  "cases": [
    {
      "name": "disarm_announces_session",
