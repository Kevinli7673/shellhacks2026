      "refersTo": "button-stop",
      "description": "The one dominant control; stops and disables driving.",
      "html": "<button class=\"ds-stop\"><span>Stop</span><kbd>Space</kbd></button>",
      "css": ".ds-stop{display:flex;align-items:center;gap:14px;background:oklch(0.585 0.215 27);color:#fff;border:0;border-radius:4px;min-height:72px;padding:12px 28px;font:700 1.728rem/1 B612,system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 10px 22px -12px oklch(0.4 0.18 27/.9);cursor:pointer;transition:background-color 150ms}.ds-stop:hover{background:oklch(0.64 0.22 27)}.ds-stop:active{background:oklch(0.52 0.2 27);box-shadow:none}.ds-stop:focus-visible{outline:3px solid oklch(0.82 0.155 78);outline-offset:3px}.ds-stop kbd{font:600 .75rem ui-monospace,Menlo,monospace;background:oklch(0 0 0/.28);border-radius:3px;padding:3px 7px}"
    },
