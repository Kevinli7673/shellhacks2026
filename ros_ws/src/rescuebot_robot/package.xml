<?xml version="1.0"?>
<package format="3">
  <name>rescuebot_robot</name>
  <version>0.1.0</version>
  <description>Physical-robot ROS 2 mapping: reads the running dashboard's LiDAR and IMU (read-only) and builds a SLAM map. Never commands motors.</description>
  <maintainer email="rescuebot@example.invalid">Rescuebot</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rescuebot_navigation</exec_depend>
  <exec_depend>rescuebot_sim_bridge</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
