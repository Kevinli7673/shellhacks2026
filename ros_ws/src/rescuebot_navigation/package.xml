<?xml version="1.0"?>
<package format="3">
  <name>rescuebot_navigation</name>
  <version>0.1.0</version>
  <description>Simulation SLAM, Nav2, Collision Monitor, and mission control for Rescuebot.</description>
  <maintainer email="rescuebot@example.invalid">Rescuebot</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rescuebot_sim_bridge</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
