<?xml version="1.0"?>
<sdf version="1.9">
  <model name="rescuebot">
    <self_collide>false</self_collide>
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial><mass>3.0</mass><inertia><ixx>0.03</ixx><iyy>0.04</iyy><izz>0.06</izz></inertia></inertial>
      <visual name="body"><geometry><box><size>0.30 0.25 0.10</size></box></geometry><material><diffuse>0.9 0.25 0.05 1</diffuse></material></visual>
      <collision name="body"><geometry><box><size>0.30 0.25 0.10</size></box></geometry></collision>
    </link>

    <link name="front_left_wheel_link"><pose>0.11 0.10 0.05 1.5708 0 0</pose><inertial><mass>0.15</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial><visual name="wheel"><geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry></visual><collision name="wheel"><geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry></collision></link>
    <link name="front_right_wheel_link"><pose>0.11 -0.10 0.05 1.5708 0 0</pose><inertial><mass>0.15</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial><visual name="wheel"><geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry></visual><collision name="wheel"><geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry></collision></link>
    <link name="rear_left_wheel_link"><pose>-0.11 0.10 0.05 1.5708 0 0</pose><inertial><mass>0.15</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial><visual name="wheel"><geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry></visual><collision name="wheel"><geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry></collision></link>
    <link name="rear_right_wheel_link"><pose>-0.11 -0.10 0.05 1.5708 0 0</pose><inertial><mass>0.15</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial><visual name="wheel"><geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry></visual><collision name="wheel"><geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry></collision></link>

    <joint name="front_left_wheel_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="front_right_wheel_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="rear_left_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="rear_right_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>

    <link name="lidar_link"><pose>0 0 0.16 0 0 0</pose><sensor name="lidar" type="gpu_lidar"><always_on>1</always_on><update_rate>10</update_rate><topic>scan</topic><frame_id>lidar_link</frame_id><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range></lidar></sensor></link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
    <link name="imu_link"><pose>0 0 0.08 0 0 0</pose><sensor name="imu" type="imu"><always_on>1</always_on><update_rate>50</update_rate><topic>imu</topic><frame_id>imu_link</frame_id></sensor></link>
    <joint name="imu_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>
    <link name="ai_camera_link"><pose>0.15 0 0.18 0 0 0</pose></link><joint name="ai_camera_joint" type="fixed"><parent>base_link</parent><child>ai_camera_link</child></joint>
    <link name="logitech_camera_link"><pose>0.15 0 0.19 0 0 0</pose></link><joint name="logitech_camera_joint" type="fixed"><parent>base_link</parent><child>logitech_camera_link</child></joint>

    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>0.20</wheel_separation><wheelbase>0.22</wheelbase><wheel_radius>0.05</wheel_radius>
      <topic>cmd_vel</topic><odom_topic>odom</odom_topic><odom_publish_frequency>30</odom_publish_frequency>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
    </plugin>
  </model>
</sdf>
