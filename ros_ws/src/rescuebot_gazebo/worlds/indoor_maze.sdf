<?xml version="1.0"?>
<sdf version="1.9">
  <world name="indoor_maze">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><direction>-0.4 0.2 -0.9</direction></light>
    <model name="floor"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material></visual></link></model>
    <model name="wall_north"><static>true</static><pose>0 3 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>6 0.15 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>6 0.15 1.5</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -3 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>6 0.15 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>6 0.15 1.5</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>3 0 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 6 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 6 1.5</size></box></geometry></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-3 0 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 6 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 6 1.5</size></box></geometry></visual></link></model>
    <model name="divider"><static>true</static><pose>0.7 0.7 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 3 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 3 1.5</size></box></geometry></visual></link></model>
  </world>
</sdf>
